FROM ubuntu:22.04

ARG TARGETARCH

RUN apt-get update && apt-get install -y wget tar ca-certificates build-essential && \
    wget https://go.dev/dl/go1.16.linux-$TARGETARCH.tar.gz && \
    tar -C /usr/local -xzf go1.16.linux-$TARGETARCH.tar.gz && \
    rm go1.16.linux-$TARGETARCH.tar.gz && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

ENV GOPATH="/go"
ENV PATH="$PATH:/usr/local/go/bin:$GOPATH/bin"

WORKDIR /usr/src/app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go test ./...
RUN go build -o server .

ENV PORT=8080
ENV REQUEST_ORIGIN=https://example.com

EXPOSE $PORT

CMD ["./server"]
